{
  "name": "@oblivion-labs-dev/arsenal-applypilot-extension",
  "version": "0.1.2",
  "description": "Chrome MV3 Extension for job application autofill and self-learning answer memory",
  "type": "module",
  "scripts": {
    "build": "tsup && node scripts/copy-assets.js && node scripts/verify-dist.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:resume-parser": "vitest run server/resumeParser.test.js",
    "server": "node server.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:browser": "node scripts/browser-verify.mjs"
  },
  "dependencies": {
    "@oblivion-labs-dev/arsenal-shared": "workspace:*",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/chrome": "^0.0.306",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
