{
  "name": "@oblivion-labs-dev/arsenal-backend",
  "version": "0.1.0",
  "description": "Backend utilities: OpenRouter client, retry, logging, env validation, and API helpers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@oblivion-labs-dev/arsenal-shared": "workspace:*",
    "feedsmith": "^3.0.1",
    "nodemailer": "^6.9.13",
    "openai": "^7.53.0",
    "undici": "^8.12.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.14",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Oblivion-Labs-Dev/Arsenal.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
