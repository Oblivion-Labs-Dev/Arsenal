{
  "name": "@arsenal/scene",
  "version": "0.1.0",
  "description": "Reusable live layers for cinematic art-plate heroes: water, falls, glass rings, orbit lights, sphere and beam, in one WebGL pass.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:browser && npm run build",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "^22.20.5",
    "rimraf": "^6.0.1",
    "typescript": "~5.7.2",
    "vitest": "^4.1.9",
    "react": "^19.3.1",
    "@types/react": "^19.3.0"
  },
  "private": true,
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
