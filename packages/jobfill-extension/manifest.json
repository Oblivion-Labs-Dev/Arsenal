{
  "manifest_version": 3,
  "name": "Arsenal JobFill",
  "version": "0.1.2",
  "description": "Chrome MV3 Extension for job application autofill and self-learning answer memory",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "http://localhost:8085/*",
    "<all_urls>"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.global.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.global.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
