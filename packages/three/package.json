{
  "name": "@arsenal/three",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Optional three.js / React Three Fiber scenes: gravity well accretion disk and the anomaly sphere. Kept out of @arsenal/fx so the core stays light.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "@react-three/fiber": "^8.18.0 || ^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "three": ">=0.160.0"
  },
  "dependencies": {
    "@arsenal/fx": "workspace:*"
  },
  "devDependencies": {
    "@react-three/fiber": "9.4.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "0.184.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "three": "0.184.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2"
  }
}
