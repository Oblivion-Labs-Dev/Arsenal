{
  "name": "@arsenal/agent-autoreview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scoped autonomous implementation-verification for coding agents — reviews only task-changed code",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "arsenal-autoreview": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    }
  },
  "files": [
    "dist",
    "prompts",
    "templates",
    "integrations",
    "autoreview.config.ts",
    "quality-gates.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@arsenal/agent-memory": "workspace:*",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
