{
  "name": "@arsenal/context-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable AI context engine for repo maps, knowledge graphs, and token-efficient agent context",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "arsenal-context": "./dist/cli/arsenal-context-cli.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@arsenal/budget": "workspace:*",
    "@arsenal/context": "workspace:*",
    "@arsenal/core": "workspace:*",
    "@arsenal/policy": "workspace:*",
    "@arsenal/prompt": "workspace:*",
    "@arsenal/retrieval": "workspace:*",
    "@arsenal/session-memory": "workspace:*",
    "@arsenal/summary": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2"
  }
}
